{
  "name": "owner-dashboard-v6",
  "version": "1.0.0",
  "description": "Dynasty HQ web app (web-only) \u2014 draft war room, earnings tracking, free agent targets",
  "main": "index.html",
  "scripts": {
    "test": "node tests/run.js && node tests/season-odds-engines.js && node tests/faab-engine.js && node tests/chopped.js && node tests/chop-odds.js",
    "test:core": "node tests/run.js",
    "sync:shared": "node scripts/sync-reconai-shared.cjs",
    "build:preview": "npm run sync:shared && node scripts/build-preview.cjs",
    "build:deploy": "npm run sync:shared && node scripts/build-deploy.cjs",
    "preview:prod": "npm run build:preview && node scripts/serve-static.cjs --port=3002",
    "prepare": "husky || true",
    "start": "npm run sync:shared && node scripts/serve-static.cjs --port=3001 --compile",
    "dev": "npm run sync:shared && node scripts/serve-static.cjs --port=3001 --compile",
    "dev:raw": "npm run sync:shared && node scripts/serve-static.cjs --port=3001",
    "landing:edit": "node scripts/serve-static.cjs --port=3011 --open=landing-editor.html",
    "test:landing-auth": "node tests/landing-auth-browser.cjs",
    "test:espn-transactions": "node tests/espn-transaction-feed.cjs && node tests/espn-transaction-browser.cjs",
    "test:espn-hub": "node tests/public-espn-hub.cjs && node tests/public-espn-browser.cjs",
    "test:landing-session": "node tests/landing-session-lifecycle.cjs && node tests/landing-session-browser.cjs",
    "test:connect": "node tests/public-connect.cjs && node tests/public-connect-browser.cjs",
    "test:web-billing": "node tests/web-billing-client.cjs && node tests/web-billing-browser.cjs",
    "test:trade-picks": "node tests/trade-pick-inventory.cjs && node tests/trade-pick-browser.cjs",
    "test:public-portfolio": "node tests/public-portfolio.cjs && node tests/public-portfolio-browser.cjs",
    "test:yahoo-transactions": "node tests/yahoo-transaction-feed.cjs && node tests/yahoo-transaction-browser.cjs",
    "test:public-empire": "node tests/public-empire.cjs && node tests/public-empire-browser.cjs",
    "test:mfl-drafts": "node tests/mfl-draft-context.cjs && node tests/mfl-draft-browser.cjs"
  },
  "keywords": [
    "fantasy",
    "football",
    "dashboard"
  ],
  "author": "skjjcruz",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@babel/standalone": "^7.29.7",
    "esbuild": "^0.28.0",
    "terser": "^5.48.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.59.1",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "eslint"
    ]
  }
}
